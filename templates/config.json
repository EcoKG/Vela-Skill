{
  "version": "1.0",
  "engine": "vela",
  "language": "ko",
  "sandbox": {
    "enabled": true
  },
  "gate_guard": {
    "enabled": true
  },
  "review_gate": {
    "enabled": true,
    "validation_rounds": 1,
    "steps": ["execute"]
  },
  "scale_guard": {
    "enabled": true,
    "thresholds": {
      "downgrade_signals_min": 2,
      "upgrade_signals_min": 2
    }
  },
  "changeSurface": {
    "enabled": true,
    "excludePaths": [
      "node_modules",
      ".git",
      ".gsd",
      ".vela/artifacts",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml"
    ],
    "minTokenLength": 3
  }
}
