{
  "version": "2.0",
  "_doc": "v8.0 — 3 pipelines × 6 steps (down from 6 variants × 13 steps). Opus 4.7 adaptive thinking + task_budget 시대에 맞춘 슬림화. v7.3-M3에서 plan-check/checkpoint/branch/diff-summary/learning/finalize 단계 삭제: plan 단계가 research+self-check 흡수, commit 단계가 branch+finalize 흡수, reviewer가 verify+diff-summary 흡수.",
  "pipelines": {
    "ship": {
      "description": "Default 6-step pipeline — init → locate → plan → execute → verify → commit",
      "steps_only": ["init", "locate", "plan", "execute", "verify", "commit"],
      "steps": [
        {
          "id": "init",
          "name": "Initialize",
          "actor": "pm",
          "mode": "read",
          "entry_gate": [],
          "exit_gate": ["artifact_dir_created", "mode_detected", "git_clean"],
          "artifacts": [".vela/artifacts/{YYYYMMDD}T{HHmmss}-{slug}/meta.json"],
          "max_revisions": 1,
          "_note": "v8.0: branch 생성 로직 흡수 — init이 vela/{slug} 브랜치도 생성한다."
        },
        {
          "id": "locate",
          "name": "Locate Targets",
          "actor": "pm",
          "mode": "read",
          "entry_gate": ["init_complete"],
          "exit_gate": ["targets_json_exists"],
          "artifacts": ["targets.json"],
          "max_revisions": 1,
          "description": "Universal Locate — deterministic file/symbol identification via vela-engine locate (no LLM)"
        },
        {
          "id": "plan",
          "name": "Research + Plan",
          "actor": "agent",
          "mode": "write",
          "entry_gate": ["targets_json_exists"],
          "exit_gate": ["plan_md_exists", "plan_architecture_complete", "approval_exists"],
          "artifacts": ["plan.md"],
          "max_revisions": 3,
          "team": {
            "worker_role": "planner",
            "reviewer_role": "reviewer",
            "approver": "pm"
          },
          "architecture": {
            "required_sections": ["## Architecture", "## Class Specification", "## Test Strategy", "## Self-Check"],
            "min_section_bytes": 200
          },
          "_note": "v8.0: research 단계 흡수 — planner가 파일 읽고 분석한 뒤 plan.md 작성. plan-check 흡수 — ## Self-Check 섹션에서 자체 검증."
        },
        {
          "id": "execute",
          "name": "Implementation",
          "actor": "agent",
          "mode": "readwrite",
          "entry_gate": ["plan_md_exists"],
          "exit_gate": ["implementation_complete", "review_exists", "ref_integrity"],
          "artifacts": ["task-summary.md"],
          "max_revisions": 5,
          "sub_phases": ["test-write", "implement", "refactor"],
          "sub_phase_tracking": true,
          "team": {
            "worker_role": "executor",
            "reviewer_role": "reviewer",
            "approver": "pm"
          }
        },
        {
          "id": "verify",
          "name": "Verification + Review",
          "actor": "agent",
          "mode": "rw-artifact",
          "entry_gate": ["implementation_complete"],
          "exit_gate": ["verification_md_exists", "ref_integrity"],
          "artifacts": ["verification.md"],
          "max_revisions": 3,
          "team": {
            "worker_role": "reviewer",
            "approver": "pm"
          },
          "_note": "v8.0: reviewer가 테스트+린트+타입체크(Bash) + diff 요약까지 한 번에 수행. 별도 verifier/diff-summary 에이전트 없음. diff >500 LOC 시 /ultrareview 번들 스킬로 에스컬레이션."
        },
        {
          "id": "commit",
          "name": "Commit + Finalize",
          "actor": "pm",
          "mode": "read",
          "entry_gate": ["verification_md_exists"],
          "exit_gate": ["changes_committed"],
          "artifacts": ["diff.patch"],
          "max_revisions": 1,
          "git": {
            "conventional_commits": true,
            "type_map": {
              "code": "feat",
              "code-bug": "fix",
              "code-refactor": "refactor",
              "docs": "docs",
              "infra": "chore",
              "analysis": "chore"
            },
            "include_pipeline_ref": true
          },
          "_note": "v8.0: finalize 흡수 — commit 시점에 git diff --stat으로 요약을 자동 생성, report.md 파일은 선택."
        }
      ]
    },

    "fix": {
      "description": "Surgical 6-step pipeline — 작은 수정(<50 LOC diff)에 최적화. plan이 mode=spec으로 patch-spec.md(file:line Before/After) 생성, executor가 범위 엄수.",
      "inherits": "ship",
      "steps_only": ["init", "locate", "plan", "execute", "verify", "commit"],
      "overrides": {
        "plan": {
          "artifacts": ["patch-spec.md"],
          "architecture": {
            "required_sections": ["## Target Files", "## Before/After", "## Explicitly out of scope"],
            "min_section_bytes": 100
          },
          "_note": "mode=spec — planner가 patch-spec.md 작성. plan.md 대신 file:line Before/After + out-of-scope 범위."
        },
        "execute": {
          "max_revisions": 3,
          "_note": "patch-spec.md의 ## Before/After 블록만 정확히 적용. ## Explicitly out of scope 영역 수정 금지."
        }
      }
    },

    "hotfix": {
      "description": "Minimal 4-step pipeline — docs/config 수정. plan/verify 생략.",
      "inherits": "ship",
      "steps_only": ["init", "locate", "execute", "commit"],
      "overrides": {
        "execute": {
          "entry_gate": ["targets_json_exists"],
          "exit_gate": ["implementation_complete"],
          "max_revisions": 2,
          "mode": "write"
        },
        "commit": {
          "entry_gate": ["implementation_complete"],
          "exit_gate": ["changes_committed"]
        }
      }
    }
  },

  "scales": {
    "_deprecated_doc": "v8.0: small/medium/large/ralph는 모두 ship으로 통합됨. 구 명령 사용 시 skills/{small,medium,large,ralph}/SKILL.md의 deprecation 셤이 ship으로 자동 리다이렉트.",
    "small":  "ship",
    "medium": "ship",
    "large":  "ship",
    "ralph":  "ship",
    "hotfix": "hotfix",
    "fix":    "fix",
    "ship":   "ship"
  },

  "modes": {
    "read": {
      "allowed_tools": ["Read", "Glob", "Grep", "Bash", "WebSearch"],
      "blocked_tools": ["Edit", "Write", "NotebookEdit"],
      "bash_policy": "read_only",
      "treenode_cache": true
    },
    "write": {
      "allowed_tools": ["Read", "Write", "Glob", "Grep"],
      "blocked_tools": ["Edit", "Bash", "NotebookEdit"],
      "bash_policy": "blocked",
      "treenode_cache": false
    },
    "readwrite": {
      "allowed_tools": ["Read", "Write", "Edit", "NotebookEdit", "Glob", "Grep", "Agent"],
      "blocked_tools": [],
      "bash_policy": "restricted",
      "treenode_cache": true
    },
    "rw-artifact": {
      "allowed_tools": ["Read", "Glob", "Grep", "Bash", "WebSearch", "Write"],
      "blocked_tools": ["Edit", "NotebookEdit"],
      "bash_policy": "read_only",
      "treenode_cache": true,
      "artifact_write_only": true
    }
  },

  "git": {
    "gitignore_entries": [
      ".vela/cache/",
      ".vela/state/",
      ".vela/artifacts/",
      ".vela/tracker-signals.json",
      ".vela/write-log.jsonl",
      "*.vela-tmp"
    ]
  },

  "presets": {
    "auth":      { "scale": "ship",   "task_type": "code",           "hint": "인증/권한/OAuth 구현" },
    "api-crud":  { "scale": "ship",   "task_type": "code",           "hint": "CRUD API 엔드포인트 추가" },
    "bugfix":    { "scale": "fix",    "task_type": "code-bug",       "hint": "버그 수정 (surgical, 작은 diff)" },
    "refactor":  { "scale": "ship",   "task_type": "code-refactor",  "hint": "코드 리팩터링" },
    "migration": { "scale": "ship",   "task_type": "code",           "hint": "DB 마이그레이션/스키마 변경" },
    "docs":      { "scale": "hotfix", "task_type": "docs",           "hint": "문서/README/주석 수정" }
  }
}
